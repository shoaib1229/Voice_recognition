# ============================================================
# .env.example — Nova Voice Assistant
# Copy this file to .env and fill in optional values.
# NEVER commit .env to version control.
# ============================================================

# === External API Keys ===
OPENWEATHER_API_KEY=your_openweather_api_key_here

# === Speech Recognition ===
# BCP-47 language tag (e.g. en-IN, en-US, en-GB)
SPEECH_LANGUAGE=en-IN
# Seconds to wait for speech to begin
SPEECH_TIMEOUT=7
# Max seconds of a single phrase
SPEECH_PHRASE_LIMIT=20
# Seconds allowed for the speech recognition service request
SPEECH_RECOGNITION_TIMEOUT=15

# === Text-to-Speech ===
# Words per minute (100–250 is comfortable; default 175)
TTS_RATE=175
# Volume level: 0.0 (silent) to 1.0 (full)
TTS_VOLUME=1.0

# === Logging ===
# Choices: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log

# === Application Paths (leave blank to use PATH/registry detection) ===
CHROME_PATH=
EDGE_PATH=
VSCODE_PATH=
WHATSAPP_PATH=
SPOTIFY_PATH=

# === Custom Folder Paths ===
# Absolute path to your personal project root folder
PROJECT_FOLDER=

# === Future: wake-word ===
# WAKE_WORD=nova
# WAKE_WORD_ENABLED=false